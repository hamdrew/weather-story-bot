region = "us-east-2"

# A private test channel whose only admin is the staging bot, never a public channel.
offices = {
  MKX = {
    chat_id = "-100REPLACE_ME"
    name    = "Milwaukee/Sullivan"
  }
}

nws_user_agent = "weather-story-bot (you@example.com)"

alert_email = "you@example.com"

# The staging bot's token, a SecureString created by hand in SSM; must be under /weather-story-bot-staging/.
telegram_token_param_name = "/weather-story-bot-staging/telegram-token"

# From the bootstrap stack (infra/bootstrap): `terraform output` there prints both. The boundary
# must be this environment's own, policy/weather-story-bot-staging-boundary.
artifacts_bucket         = "weather-story-bot-artifacts-123456789012"
permissions_boundary_arn = "arn:aws:iam::123456789012:policy/weather-story-bot-staging-boundary"
