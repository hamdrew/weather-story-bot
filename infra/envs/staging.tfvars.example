region = "us-east-2"

# A private test channel whose only admin is the staging bot, never a public channel.
offices = {
  MKX = {
    chat_id = "-100REPLACE_ME"
    name    = "Milwaukee/Sullivan"
  }
}

nws_user_agent = "weather-story-bot (you@example.com)"

alert_email = "you@example.com"

# The staging bot's token, a SecureString created by hand in SSM; must be under /weather-story-bot-staging/.
telegram_token_param_name = "/weather-story-bot-staging/telegram-token"
