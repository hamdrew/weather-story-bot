# The OIDC subject prefix of the repository whose workflows may assume the CI roles:
#   gh api repos/<owner>/weather-story-bot/actions/oidc/customization/sub --jq .sub_claim_prefix
github_subject_prefix = "repo:OWNER@OWNER_ID/weather-story-bot@REPOSITORY_ID"

# The bucket that holds every stack's Terraform state (the same one as envs/*.backend.hcl).
state_bucket = "REPLACE-ME-terraform-state"

# region = "us-east-2"
