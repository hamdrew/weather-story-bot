#!/usr/bin/env bash
#MISE description="Apply the bootstrap stack's saved plan (ask first: needs MFA, changes live infrastructure)"
set -euo pipefail

export TF_DATA_DIR=.terraform-bootstrap

[[ -f infra/bootstrap/deploy-bootstrap.tfplan ]] || {
  echo "No saved plan (infra/bootstrap/deploy-bootstrap.tfplan). Run mise run bootstrap-plan first." >&2
  exit 1
}
terraform -chdir=infra/bootstrap init -input=false -backend-config=backend.hcl
terraform -chdir=infra/bootstrap apply deploy-bootstrap.tfplan
rm infra/bootstrap/deploy-bootstrap.tfplan
