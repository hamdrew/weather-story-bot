# Copy to .env and fill in values for `make dry-run` / the local `--dry-run` CLI.
# .env is gitignored and only read by the local dry run, never by the Lambda handler.

NWS_USER_AGENT="weather-story-bot (you@example.com)"

# Only needed with `--send-telegram`, which posts the stories to a test channel.
# The bot must be added to the channel as an admin that can post messages.
# TELEGRAM_BOT_TOKEN="123456:ABC-your-bot-token"
# TELEGRAM_CHAT_ID="-1001234567890"   # or "@your_test_channel"
