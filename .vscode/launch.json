{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Weather Story Bot: Dry Run",
            "type": "debugpy",
            "request": "launch",
            "module": "weather_story_bot",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["--dry-run"]
        },
        {
            "name": "Migrate Table Keys: Dry Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/migrate_table_keys.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [],
            // The ReadOnly role can't write, so this stays a dry run even if --apply is added.
            "env": {"AWS_PROFILE": "readonly"}
        },
        {
            "name": "Migrate Story Keys: Dry Run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/migrate_story_keys.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [],
            // The ReadOnly role can't write, so this stays a dry run even if --apply is added.
            "env": {"AWS_PROFILE": "readonly"}
        },
        {
            "name": "Infracost Usage: Write",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/infracost_usage.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            // Writes to build/debug-usage, not build/, which infracost.yml reads.
            "args": ["write", "build/debug-usage"]
        },
        {
            "name": "Infracost Usage: Report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/infracost_usage.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            // Run `mise run cost` first so build/infracost.json exists.
            "args": ["report", "build/infracost.json"]
        },
        {
            "name": "Build Zip: Hash Package",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/build_zip.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            // Run `mise run build` first so build/package exists. This writes build/debug.zip, not
            // build/lambda.zip, so a debug session can't change the zip `mise run plan` hashes. It
            // does remove build/package/bin in place (the console scripts); `mise run build` redoes it.
            "args": ["build/package", "build/debug.zip"]
        },
        {
            "name": "Tests: Debug Test",
            "type": "debugpy",
            "request": "launch",
            // Used by the Testing panel's "Debug Test", not F5. Tests are offline (moto + respx),
            // so stepping into botocore, httpx or moto never reaches AWS, Telegram or NWS.
            "purpose": ["debug-test"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            // Step into libraries and stop at breakpoints set in them, such as moto's
            // transact_write_items.
            "justMyCode": false
        }
    ]
}